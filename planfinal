<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Plan Comunitario de Preparación y Resiliencia ante Emergencias — La Playa de Ponce</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap');

:root{
  --yellow:#FFD400;
  --yellow-deep:#F5C400;
  --black:#111111;
  --ink:#1a1a1a;
  --gray:#5b5b5b;
  --line:#dcdcdc;
  --paper:#ffffff;
}

*{box-sizing:border-box;}
html,body{margin:0;padding:0;background:#e9e9e9;}
body{
  font-family:'Source Serif 4', Georgia, 'Times New Roman', serif;
  color:var(--ink);
  font-size:12.3pt;
  line-height:1.55;
}
h1,h2,h3,.run-in,.callout-head span,.toc-label,.annex-title{
  font-family:'Poppins', 'Segoe UI', Arial, sans-serif;
}

img{max-width:100%;display:block;}

/* ---------------- Page geometry ---------------- */
@page{ size:8.5in 11in; margin:0; }

.page-frame{
  width:8.5in;
  min-height:11in;
  margin:0 auto;
  background:var(--paper);
  position:relative;
}

@media screen{
  .page-frame{ margin:24px auto; box-shadow:0 4px 24px rgba(0,0,0,.18); }
}

.cover, .frontmatter, .toc-page, .chapter{
  width:8.5in;
  min-height:11in;
  box-sizing:border-box;
  background:var(--paper);
  page-break-after:always;
  break-after:page;
  position:relative;
}
@media screen{
  .cover, .frontmatter, .toc-page, .chapter{
    margin:0 auto 24px auto;
    box-shadow:0 4px 24px rgba(0,0,0,.18);
  }
}

/* ---------------- Icons ---------------- */
.ic{ width:1em; height:1em; stroke:currentColor; vertical-align:-0.15em; flex-shrink:0; }

/* ---------------- Cover ---------------- */
.cover{ padding:0; overflow:hidden; display:flex; flex-direction:column; }
.cover-topbar{
  background:var(--paper);
  color:var(--black);
  display:flex; align-items:center; gap:12px;
  padding:0.35in 0.6in;
  font-family:'Poppins',sans-serif;
  font-weight:600;
  font-size:10.5pt;
  border-bottom:6px solid var(--yellow);
}
.cover-topbar .crest{ width:28px;height:28px; }
.cover-art{
  background:var(--yellow);
  flex:1;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:0.3in 0.6in;
  overflow:hidden;
}
.cover-art img{ max-height:5.4in; width:auto; margin:0 auto; }
.cover-text{
  background:var(--yellow);
  padding:0.3in 0.6in 0.7in 0.6in;
}
.cover-text-solo{
  flex:1;
  display:flex;
  flex-direction:column;
  justify-content:center;
  padding:0.6in 0.7in;
}
.cover-text h1{
  font-size:46pt; line-height:0.98; font-weight:800; letter-spacing:-1px;
  margin:0 0 14px 0; color:var(--black);
}
.cover-text-solo h1{ font-size:64pt; margin-bottom:22px; }
.cover-text-solo h2{ font-size:19pt; margin-bottom:16px; }
.cover-text-solo p{ font-size:13pt; }

/* ---------------- Photo transition pages ---------------- */
.photo-divider{
  width:8.5in; min-height:11in; box-sizing:border-box;
  background:var(--black);
  page-break-after:always; break-after:page;
  position:relative;
  display:flex; flex-direction:column;
}
@media screen{
  .photo-divider{ margin:0 auto 24px auto; box-shadow:0 4px 24px rgba(0,0,0,.18); }
}
.pd-image{
  flex:1; overflow:hidden;
  background-size:cover; background-position:center; background-repeat:no-repeat;
}
.pd-caption{
  background:var(--yellow);
  color:var(--black);
  font-family:'Poppins',sans-serif;
  font-weight:700;
  font-size:13pt;
  padding:0.32in 0.6in;
}
.cover-text h2{
  font-size:15.5pt; font-weight:700; margin:0 0 10px 0; color:var(--black);
  font-family:'Poppins',sans-serif;
}
.cover-text p{ font-family:'Poppins',sans-serif; font-weight:600; font-size:11pt; margin:0; color:var(--black); }

/* ---------------- Front matter ---------------- */
.frontmatter{ padding:0.9in 0.75in; }
.fm-logos{ display:flex; gap:36px; align-items:center; justify-content:center; margin-bottom:0.55in; }
.fm-logos img{ max-height:1.7in; width:auto; }
.frontmatter > p{ font-size:12.5pt; text-align:center; max-width:5.6in; margin:0 auto 14px auto; }
.fm-notice{
  margin-top:0.6in;
  border-top:3px solid var(--black);
  border-bottom:3px solid var(--black);
  padding:22px 4px 24px 4px;
  text-align:center;
}
.fm-notice-tag{
  display:inline-block;
  font-family:'Poppins',sans-serif;
  font-weight:700;
  font-size:9.5pt;
  letter-spacing:0.14em;
  text-transform:uppercase;
  background:var(--yellow);
  color:var(--black);
  padding:3px 12px;
  margin-bottom:12px;
}
.fm-notice p{
  margin:0 auto; max-width:5.2in;
  font-size:11.5pt; line-height:1.6; color:var(--ink);
}

/* ---------------- TOC ---------------- */
.toc-page{ padding:0.9in 0.85in; }
.toc-page h1{ font-size:30pt; font-weight:800; margin:0 0 0.4in 0; }
.toc-list{ list-style:none; margin:0; padding:0; }
.toc-list li{ border-bottom:1px dotted var(--line); }
.toc-list li a{
  display:flex; align-items:center; gap:14px;
  text-decoration:none; color:var(--ink);
  padding:11px 2px;
}
.toc-ic{ width:22px; height:22px; color:var(--black); flex-shrink:0; }
.toc-ic .ic{ width:22px; height:22px; }
.toc-label{ font-weight:600; font-size:12pt; }

/* ---------------- Chapters ---------------- */
.chapter{ padding:0.7in 0.75in 0.85in 0.75in; }
.chapter-head{ display:flex; align-items:center; gap:16px; border-bottom:5px solid var(--yellow); padding-bottom:14px; margin-bottom:0.32in; }
.chapter-icon{ width:40px; height:40px; color:var(--black); flex-shrink:0; }
.chapter-icon .ic{ width:40px; height:40px; }
.chapter-head h1{ font-size:23pt; font-weight:800; margin:0; line-height:1.15; }

.chapter-body h2{ font-size:15pt; font-weight:700; margin:26px 0 10px 0; color:var(--black); }
.chapter-body h3{ font-size:12.5pt; font-weight:700; margin:16px 0 8px 0; color:var(--black); }
.chapter-body p{ margin:0 0 11px 0; text-align:left; }
.chapter-body p.run-in{ font-weight:700; margin:14px 0 4px 0; font-size:11.6pt; }

.doc-list{ margin:0 0 13px 0; padding-left:0; list-style:none; }
.doc-list li{
  position:relative; padding:2px 0 2px 22px; margin-bottom:5px; font-size:12pt;
}
.doc-list li::before{
  content:""; position:absolute; left:2px; top:10px;
  width:7px; height:7px; background:var(--black); border-radius:50%;
}

/* ---------------- Callouts ---------------- */
.callout{ margin:16px 0 18px 0; padding:16px 18px; border-radius:2px; page-break-inside:avoid; }
.callout-head{ display:flex; align-items:center; gap:10px; font-weight:700; font-size:11.5pt; margin-bottom:8px; }
.callout-head .ic{ width:20px;height:20px; }
.callout .doc-list{ margin-bottom:0; }
.callout-warning{ background:var(--yellow); }
.callout-warning .doc-list li::before{ background:var(--black); }
.callout-contacts{ background:#fff; border:2px solid var(--black); }
.callout-contacts .doc-list li{ font-weight:600; }

/* ---------------- Tables ---------------- */
.table-wrap{ overflow-x:auto; margin:10px 0 18px 0; }
table{ width:100%; border-collapse:collapse; font-size:10.8pt; }
table th{
  background:var(--black); color:#fff; text-align:left; padding:8px 10px;
  font-family:'Poppins',sans-serif; font-weight:600; font-size:9.7pt; letter-spacing:.02em;
}
table td{ padding:7px 10px; border-bottom:1px solid var(--line); }
table tr:nth-child(even) td{ background:#f7f7f7; }
.threat-table th:first-child, .threat-table td:first-child{ font-weight:700; white-space:nowrap; }

/* ---------------- Annexes / figures ---------------- */
.annex-block{ page-break-inside:avoid; margin-bottom:0.35in; }
.annex-title{ font-size:14pt; font-weight:700; margin:0 0 10px 0; padding:8px 12px; background:var(--yellow); display:inline-block; }
.doc-figure{ margin:8px 0 4px 0; text-align:center; }
.doc-figure img{ max-width:100%; max-height:8.6in; margin:0 auto; border:1px solid var(--line); }
.doc-figure figcaption{ font-family:'Poppins',sans-serif; font-size:9.5pt; color:var(--gray); margin-top:6px; }

/* ---------------- Print ---------------- */
@media print{
  body{ background:#fff; }
  .page-frame, .cover, .frontmatter, .toc-page, .chapter{ box-shadow:none; margin:0; }
  a{ color:inherit; text-decoration:none; }
}

</style>
